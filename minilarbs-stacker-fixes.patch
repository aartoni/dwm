From e1bddb786d45eda8a69a84b3d45746cc8414f145 Mon Sep 17 00:00:00 2001
From: aartoni <alessio@artoni.org>
Date: Fri, 9 Oct 2026 16:11:35 +0200
Subject: [PATCH] minilarbs-stacker-fixes

---
 dwm.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dwm.c b/dwm.c
index 20a316f..9dae698 100644
--- a/dwm.c
+++ b/dwm.c
@@ -1033,7 +1033,7 @@ focusstack(const Arg *arg)
 	int i = stackpos(arg);
 	Client *c, *p;
 
-	if(i < 0)
+	if(i < 0 || !selmon->sel || (selmon->sel->isfullscreen && lockfullscreen))
 		return;
 
 	for(p = NULL, c = selmon->clients; c && (i || !ISVISIBLE(c));
@@ -1494,7 +1494,7 @@ pushstack(const Arg *arg) {
 	int i = stackpos(arg);
 	Client *sel = selmon->sel, *c, *p;
 
-	if(i < 0)
+	if(i < 0 || !sel)
 		return;
 	else if(i == 0) {
 		detach(sel);
-- 
2.56.0

